# Copie este arquivo para backend/.env e preencha os valores.
# NUNCA versione o .env — ele está no .gitignore.
#
# Para gerar uma SECRET_KEY nova:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- CORS / Frontend ------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Banco de dados -------------------------------------------------------
# Padrão é SQLite. Para Postgres, defina DB_ENGINE=postgresql e as demais
# variáveis abaixo (requer: pip install psycopg[binary]).
DB_ENGINE=sqlite3
# DB_NAME=verticai
# DB_USER=verticai
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- JWT ------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Google Gemini (processamento de editais) -----------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Stripe (assinaturas) -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Limites ---------------------------------------------------------------
MAX_UPLOAD_PDF_SIZE=15728640
THROTTLE_PROCESSAR_EDITAL=10/hour
THROTTLE_REGISTRO=20/hour

# --- E-mail ---------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nao-responda@verticai.local

# --- Produção (ignorado quando DJANGO_DEBUG=True) -------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
# CSRF_TRUSTED_ORIGINS=https://app.verticai.com.br
